# Nexus Keycloak Development Environment Variables
# Copy this file to .env and update with your actual values

# =============================================================================
# KEYCLOAK CONFIGURATION
# =============================================================================
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password
KEYCLOAK_PORT=8090

# =============================================================================
# POSTGRESQL CONFIGURATION
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexus_app_dev
DB_USER=admin
DB_PASSWORD=your_postgres_password

# =============================================================================
# PGADMIN CONFIGURATION
# =============================================================================
PGADMIN_EMAIL=admin@systech.com
PGADMIN_PASSWORD=your_pgadmin_password
PGADMIN_PORT=8091

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Keycloak Realm
KEYCLOAK_REALM=nexus-dev
KEYCLOAK_CLIENT_ID=nexus-web-app

# Spring Boot Configuration
SPRING_BOOT_PORT=8080

# React Frontend Ports
REACT_PORT_1=3000
REACT_PORT_2=3001

# =============================================================================
# TEST USER CREDENTIALS (Development Only)
# =============================================================================
TEST_USER_USERNAME=nexus-user
TEST_USER_PASSWORD=your_test_user_password
TEST_ADMIN_USERNAME=nexus-admin
TEST_ADMIN_PASSWORD=your_test_admin_password

# =============================================================================
# CONTAINER CONFIGURATION
# =============================================================================
# Container names
KEYCLOAK_CONTAINER_NAME=keycloak-dev
POSTGRES_CONTAINER_NAME=postgres-dev
PGADMIN_CONTAINER_NAME=pgadmin-dev

# Volume names
POSTGRES_VOLUME_NAME=pgdata
PGADMIN_VOLUME_NAME=pgadmin-data

# =============================================================================
# DEVELOPMENT FLAGS
# =============================================================================
# Set to true for development mode features
DEBUG_MODE=true
ENABLE_CORS=true
LOG_LEVEL=INFO